page {
  min-height: 100vh;
  background: #f6f7f9;
  color: #111827;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}

.page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 32rpx;
}

.title {
  display: block;
  font-size: 42rpx;
  font-weight: 700;
  line-height: 1.25;
}

.subtitle {
  display: block;
  margin-top: 10rpx;
  color: #6b7280;
  font-size: 26rpx;
}

.section {
  margin-top: 28rpx;
}

.field {
  margin-top: 22rpx;
}

.label {
  display: block;
  margin-bottom: 12rpx;
  color: #374151;
  font-size: 26rpx;
  font-weight: 600;
}

.input,
.textarea {
  box-sizing: border-box;
  width: 100%;
  min-height: 88rpx;
  padding: 0 24rpx;
  border: 1rpx solid #d1d5db;
  border-radius: 8rpx;
  background: #ffffff;
  font-size: 30rpx;
}

.textarea {
  min-height: 160rpx;
  padding-top: 20rpx;
}

.primary-button {
  margin-top: 32rpx;
  border-radius: 8rpx;
  background: #0f766e;
  color: #ffffff;
  font-weight: 600;
}

.secondary-button {
  margin-top: 18rpx;
  border-radius: 8rpx;
  background: #ffffff;
  color: #111827;
}

.danger-button {
  margin-top: 28rpx;
  border-radius: 8rpx;
  background: #b91c1c;
  color: #ffffff;
}

.empty {
  margin-top: 48rpx;
  color: #6b7280;
  text-align: center;
  font-size: 28rpx;
}

.card {
  box-sizing: border-box;
  border: 1rpx solid #e5e7eb;
  border-radius: 8rpx;
  background: #ffffff;
}
