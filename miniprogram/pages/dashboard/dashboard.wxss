.dashboard-page {
  padding-bottom: 40rpx;
}

.top-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.top-row > view {
  flex: 1;
  min-width: 0;
  margin-right: 20rpx;
}

.add-button {
  flex: 0 0 auto;
  height: 72rpx;
  min-width: 176rpx;
  margin: 0;
  border-radius: 8rpx;
  background: #0f766e;
  color: #ffffff;
  font-size: 26rpx;
  line-height: 72rpx;
}

.summary-list {
  display: flex;
  flex-wrap: wrap;
  margin-top: 28rpx;
  margin-right: -18rpx;
}

.summary-item {
  flex: 1 1 300rpx;
  min-height: 128rpx;
  margin-right: 18rpx;
  margin-bottom: 18rpx;
  padding: 22rpx;
}

.summary-label {
  display: block;
  color: #6b7280;
  font-size: 24rpx;
}

.summary-value {
  display: block;
  margin-top: 12rpx;
  font-size: 34rpx;
  font-weight: 700;
  line-height: 1.2;
}

.account-list {
  margin-top: 24rpx;
}

.account-card {
  margin-bottom: 18rpx;
  padding: 24rpx;
}

.account-card.over {
  border-color: #fecaca;
  background: #fffafa;
}

.account-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.account-name {
  font-size: 30rpx;
  font-weight: 700;
}

.account-left {
  margin-left: 16rpx;
  color: #0f766e;
  font-size: 24rpx;
  font-weight: 600;
  text-align: right;
}

.account-card.over .account-left {
  color: #b91c1c;
}

.money-row {
  display: flex;
  justify-content: space-between;
  margin-top: 18rpx;
  color: #4b5563;
  font-size: 24rpx;
}

.money-row text + text {
  margin-left: 16rpx;
  text-align: right;
}

.progress-track {
  height: 14rpx;
  margin-top: 18rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: #e5e7eb;
}

.progress-fill {
  height: 100%;
  border-radius: 999rpx;
  background: #0f766e;
}

.progress-fill.over {
  background: #b91c1c;
}
